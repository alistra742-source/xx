# ---- Server ----
PORT=3000
HOST=0.0.0.0
# Where finished MP4/WebM exports and temporary render files are written.
# On Railway, point this at a mounted volume (e.g. /data/stick-videos) to survive restarts.
OUTPUT_DIR=/tmp/stick-videos
JOB_TTL_MINUTES=30
MAX_EXPORT_QUEUE=3

# ---- Export ----
# ffmpeg must be on PATH, or set the absolute path here (e.g. /usr/bin/ffmpeg).
FFMPEG_BIN=ffmpeg

# ---- Local LLM (optional) ----
# The LLM writes each story from the user's prompt. Any OpenAI-compatible endpoint works.
# Hosted (recommended on Railway), e.g. Groq:
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_API_KEY=<your key, set in Railway variables, never in git>
#   LLM_MODEL=llama-3.1-8b-instant
# Self-hosted llama-server (LLAMA_URL is used when LLM_BASE_URL is empty):
#   llama-server -m models/qwen2.5-0.5b-instruct-q4_k_m.gguf --port 8080 -c 2048 --parallel 1
# Leave both empty to use the built-in template script generator only.
LLM_ENABLED=true
LLM_BASE_URL=
LLM_API_KEY=
# Or just set GROQ_API (Groq key). It selects https://api.groq.com/openai/v1 with llama-3.1-8b-instant,
# the cheapest and fastest Groq model.
GROQ_API=
LLM_MODEL=llama-3.1-8b-instant
LLAMA_URL=
LLM_TIMEOUT_MS=45000
LLM_COOLDOWN_MS=120000
LLM_MAX_TOKENS=700

# ---- Narration ----
# auto    -> uses local espeak-ng if installed, with free neural-tts fallback (default)
# espeak  -> uses the espeak-ng binary installed on the host
# gtts    -> uses free Google Translate TTS
# http    -> POSTs {"text","language"} to TTS_URL and expects audio/wav back
# none    -> no audio is generated (video still gets subtitles)
TTS_PROVIDER=auto
ESPEAK_BIN=espeak-ng
TTS_URL=
TTS_TIMEOUT_MS=30000
# Neural male narration (used automatically in auto mode when set). Put the key in your host's
# secret store (Railway variables), never in this file or in git.
ELEVENLABS_API=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
