# ---- Server ----
PORT=3000
HOST=0.0.0.0
# Where finished MP4/WebM exports and temporary render files are written.
# On Railway, point this at a mounted volume (e.g. /data/stick-videos) to survive restarts.
OUTPUT_DIR=/tmp/stick-videos
JOB_TTL_MINUTES=30
MAX_EXPORT_QUEUE=3

# ---- Export ----
# ffmpeg must be on PATH, or set the absolute path here (e.g. /usr/bin/ffmpeg).
FFMPEG_BIN=ffmpeg

# ---- Story AI (required for generation) ----
# The LLM writes each story from the user's prompt. There is no hosted provider key:
# run a local OpenAI-compatible server and point LLAMA_URL at its /v1 base.
#
# llama.cpp (model helper: ./scripts/download-model.sh):
#   llama-server -m models/qwen2.5-0.5b-instruct-q4_k_m.gguf --port 8080 -c 4096 --parallel 1
#   LLAMA_URL=http://127.0.0.1:8080/v1
# Ollama instead of llama.cpp:
#   ollama pull qwen2.5:3b
#   LLAMA_URL=http://127.0.0.1:11434/v1
#
# LLM_BASE_URL wins over LLAMA_URL when both are set. Missing/failed AI configuration
# returns an error, never a preset story.
LLM_ENABLED=true
LLAMA_URL=http://127.0.0.1:8080/v1
LLM_BASE_URL=
LLM_API_KEY=
# Empty = use whatever model the local server serves. Set it only when that server
# exposes several models (e.g. Ollama).
LLM_MODEL=
LLM_TIMEOUT_MS=45000
LLM_COOLDOWN_MS=120000
LLM_MAX_TOKENS=6000

# ---- Narration ----
# auto    -> ElevenLabs neural male voice only; no silent robotic fallback
# espeak  -> uses the espeak-ng binary installed on the host
# gtts    -> uses free Google Translate TTS
# http    -> POSTs {"text","language"} to TTS_URL and expects audio/wav back
# none    -> no audio is generated (video still gets subtitles)
TTS_PROVIDER=auto
ESPEAK_BIN=espeak-ng
TTS_URL=
TTS_TIMEOUT_MS=30000
# Neural male narration (used automatically in auto mode when set). Put the key in your host's
# secret store (Railway variables), never in this file or in git.
ELEVENLABS_API=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.4
ELEVENLABS_SIMILARITY_BOOST=0.78
ELEVENLABS_STYLE=0.25
ELEVENLABS_SPEED=1
ELEVENLABS_USE_SPEAKER_BOOST=true
