# ---- Server ----
PORT=3000
HOST=0.0.0.0
# Where finished MP4/WebM exports and temporary render files are written.
# On Railway, point this at a mounted volume (e.g. /data/stick-videos) to survive restarts.
OUTPUT_DIR=/tmp/stick-videos
JOB_TTL_MINUTES=30
MAX_EXPORT_QUEUE=3

# ---- Export ----
# ffmpeg must be on PATH, or set the absolute path here (e.g. /usr/bin/ffmpeg).
FFMPEG_BIN=ffmpeg

# ---- Local LLM (optional) ----
# Run llama.cpp's server with the Qwen GGUF model (see README -> "Installing the local model"):
#   llama-server -m models/qwen2.5-0.5b-instruct-q4_k_m.gguf --port 8080 -c 2048 --parallel 1
# Leave LLAMA_URL empty to use the built-in template script generator only.
LLM_ENABLED=true
LLAMA_URL=
LLM_TIMEOUT_MS=45000
LLM_COOLDOWN_MS=120000
LLM_MAX_TOKENS=700

# ---- Narration ----
# auto    -> uses local espeak-ng if installed, with free neural-tts fallback (default)
# espeak  -> uses the espeak-ng binary installed on the host
# gtts    -> uses free Google Translate TTS
# http    -> POSTs {"text","language"} to TTS_URL and expects audio/wav back
# none    -> no audio is generated (video still gets subtitles)
TTS_PROVIDER=auto
ESPEAK_BIN=espeak-ng
TTS_URL=
TTS_TIMEOUT_MS=30000
