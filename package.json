{
  "name": "ai-stick-figure-video-maker",
  "version": "1.0.0",
  "private": true,
  "description": "Generates faceless stick-figure animation videos: script -> scenes -> canvas animation -> MP4 (FFmpeg) or WebM fallback.",
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "dev": "concurrently -k \"node server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "check": "node --check server/index.js && npm test",
    "build:sites": "node scripts/build-sites.mjs",
    "e2e:export": "node scripts/e2e-export.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.55",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.0.1",
    "vite": "^6.4.4"
  }
}
